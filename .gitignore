*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- Env & secrets (Telegram token etc. live in Coolify env) ----
.env
.env.*
!dash/.env.development

# Google / Gemini service-account keys and other credential files — never commit
gen-lang-client-*.json
oauth_client*.json
client_secret*.json
*service-account*.json
*credentials*.json
*-key.json

# ---- Editor / OS / tooling ----
.DS_Store
.claude/settings.local.json
*.log

# TradingView login token cache (contains a live auth token)
backend/.tv_token_cache.json
*.pid
