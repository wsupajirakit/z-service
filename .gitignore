# ---- Node / frontend ----
node_modules/
dash/node_modules/
dash/dist/
dist/

# ---- Python / backend ----
backend/venv/
backend/.venv/
**/__pycache__/
*.py[cod]

# ---- Databases (runtime data, not source) ----
