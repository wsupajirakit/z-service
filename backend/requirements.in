# Top-level runtime dependencies of the backend image, pinned to the versions the test suite
# runs against. requirements.lock (all transitive deps, sha256 hashes, Python 3.12) is
# generated from this file — never edit the lock by hand:
#   uv pip compile requirements.in --python-version 3.12 \
#     --python-platform x86_64-unknown-linux-gnu --generate-hashes \
#     --exclude-newer <today - 7 days> -o requirements.lock
# then check every pin with the OSV query in tools/osv_audit.py (no known advisories).
# 7-day rule exception: a younger release is allowed only when it is the earliest one that
# fixes a known advisory; pin it below and add --exclude-newer-package <name>=<its date+1>.
# tvdatafeed is a git dependency (no hashes possible); the Dockerfile installs it separately
# pinned to a commit, see requirements-git.txt.
fastapi==0.138.2
starlette==1.3.1
uvicorn==0.49.0
pandas==3.0.3
